#!/usr/bin/env bash
# xray-tun -- enable/disable the Xray full-tunnel VPN daemon.
set -uo pipefail

UNIT=xray-tun.service
V2X=/usr/local/bin/vless2xray
CONF_DIR=/etc/xray-tun
CONF="$CONF_DIR/config.json"
NETCONF="$CONF_DIR/xray-tun.conf"

# shellcheck source=/dev/null
TUN_NAME=xtun0; RT_TABLE=8888; PREF_MARK=7080; PREF_MAIN=7100
[ -r "$NETCONF" ] && . "$NETCONF"

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi

c_ok=$'\033[32m'; c_no=$'\033[31m'; c_dim=$'\033[2m'; c_b=$'\033[1m'; c_r=$'\033[0m'
[ -t 1 ] || { c_ok=""; c_no=""; c_dim=""; c_b=""; c_r=""; }

is_on() { systemctl is-active --quiet "$UNIT"; }

# Look up the exit IP, on a short leash.
#
# This is the one thing here that talks to the network, and when the tunnel is
# broken it is talking INTO a black hole: DNS has been pointed down the tunnel
# too, so every lookup burns the full timeout. Keep the budget small and do not
# pay it twice -- a second endpoint is only worth trying if the first failed
# fast (wrong answer) rather than timing out (nothing is getting through).
# Set XRAY_TUN_NO_IP=1 to skip the probe entirely.
IP_TIMEOUT=${XRAY_TUN_IP_TIMEOUT:-4}

exit_ip() {
    [ "${XRAY_TUN_NO_IP:-0}" = 1 ] && { echo "(skipped)"; return; }
    local ip rc
    ip=$(curl -4 -s --connect-timeout "$IP_TIMEOUT" --max-time "$IP_TIMEOUT" \
         https://api.ipify.org 2>/dev/null); rc=$?
    if [ $rc -ne 0 ] && [ $rc -ne 28 ]; then
        ip=$(curl -4 -s --connect-timeout "$IP_TIMEOUT" --max-time "$IP_TIMEOUT" \
             https://ifconfig.me 2>/dev/null); rc=$?
    fi
    if [ -n "${ip:-}" ]; then
        echo "$ip"
    elif [ $rc -eq 28 ]; then
        echo "unreachable (timed out after ${IP_TIMEOUT}s)"
    else
        echo "unreachable"
    fi
}

# Is the active server reachable *without* the TUN? Answers "is it the server
# or is it the routing" in one line, using the daemon's own SOCKS inbound.
probe_socks() {
    curl -4 -s -o /dev/null --connect-timeout "$IP_TIMEOUT" \
         --max-time "$IP_TIMEOUT" \
         --socks5-hostname 127.0.0.1:10808 https://api.ipify.org 2>/dev/null
}

cmd_on() {
    $SUDO systemctl start "$UNIT" || return 1
    sleep 1
    if ! is_on; then
        echo "${c_no}failed to start${c_r} -- run: xray-tun logs" >&2
        return 1
    fi
    # Say it started before going near the network, so the prompt never looks
    # frozen while we wait on a probe that may be doomed. Only redraw in place
    # when stdout is a terminal -- in a pipe or a log, escape codes are noise.
    local prof ip
    prof=$(active_profile)
    [ -t 1 ] && printf '%stunnel up%s  %s(%s, checking...)%s' \
        "$c_ok" "$c_r" "$c_dim" "$prof" "$c_r"
    ip=$(exit_ip)
    [ -t 1 ] && printf '\r\033[K'
    printf '%stunnel up%s  %s(%s, exit IP: %s)%s\n' \
        "$c_ok" "$c_r" "$c_dim" "$prof" "$ip" "$c_r"
    case "$ip" in unreachable*)
        echo "${c_dim}traffic is not getting through. Next step:${c_r}" >&2
        if probe_socks; then
            echo "  the server answers on 127.0.0.1:10808, so the problem is" >&2
            echo "  routing -- check: ip route get 1.1.1.1 mark ${FWMARK:-255}" >&2
        else
            echo "  the server does not answer on 127.0.0.1:10808 either, so" >&2
            echo "  it is the server or the link, not the routing." >&2
            echo "  check: xray-tun show   and   xray-tun logs" >&2
        fi ;;
    esac
}

cmd_off() {
    $SUDO systemctl stop "$UNIT" || return 1
    echo "${c_ok}tunnel down${c_r}  ${c_dim}(exit IP: $(exit_ip))${c_r}"
}

active_profile() {
    if [ -L "$CONF_DIR/zz-server.json" ]; then
        basename "$(readlink "$CONF_DIR/zz-server.json")" .json
    else
        echo "no server"
    fi
}

cmd_status() {
    if is_on; then
        echo "${c_b}state${c_r}      ${c_ok}running${c_r}"
    else
        echo "${c_b}state${c_r}      ${c_no}stopped${c_r}"
    fi

    if systemctl is-enabled --quiet "$UNIT" 2>/dev/null; then
        echo "${c_b}at boot${c_r}    enabled"
    else
        echo "${c_b}at boot${c_r}    disabled"
    fi

    local dev rules
    dev=$(ip -br addr show dev "$TUN_NAME" 2>/dev/null)
    echo "${c_b}device${c_r}     ${dev:-absent}"

    rules=$(ip rule show pref "$PREF_MAIN" 2>/dev/null)
    echo "${c_b}rule${c_r}       ${rules:-absent}"
    rules=$(ip rule show pref "$PREF_MARK" 2>/dev/null)
    echo "${c_b}mark rule${c_r}  ${rules:-absent}"
    echo "${c_b}table${c_r}      $(ip route show table "$RT_TABLE" 2>/dev/null | head -1 || echo empty)"
    echo "${c_b}dns${c_r}        $(grep -m2 '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | paste -sd' ')"
    echo "${c_b}exit ip${c_r}    $(exit_ip)"

    local act
    if [ -L "$CONF_DIR/zz-server.json" ]; then
        act=$(active_profile)
        echo "${c_b}server${c_r}     $act"
    elif [ -e "$CONF_DIR/zz-server.json" ]; then
        echo "${c_b}server${c_r}     (unnamed; run 'xray-tun ls' to adopt it)"
    else
        echo "${c_b}server${c_r}     ${c_no}none configured${c_r} -- xray-tun add ..."
    fi

    conflicts
    return 0
}

# Another VPN fighting us for traffic. Most clients (sing-box, wireguard-tools,
# clash) do it with policy routing rather than a default route in "main", so
# check every table an ip rule points at, not just main.
conflicts() {
    local found="" t dev tables
    dev=$(ip route show default 2>/dev/null \
          | grep -vE "dev ${TUN_NAME}([[:space:]]|$)" \
          | grep -oE 'dev [^ ]+' | awk '{print $2}' \
          | grep -E '^(tun|tap|wg|utun|proton|nordlynx|mullvad)' || true)
    [ -n "$dev" ] && found="$dev (main table)"

    tables=$(ip rule show 2>/dev/null \
             | awk '{for (i=1;i<=NF;i++) if ($i=="lookup") print $(i+1)}' \
             | sort -u | grep -vE "^(local|main|default|${RT_TABLE})$" || true)
    for t in $tables; do
        dev=$(ip route show table "$t" 2>/dev/null | awk '/^default/{print $NF; exit}')
        [ -n "$dev" ] && [ "$dev" != "$TUN_NAME" ] && found="${found:+$found, }$dev (table $t)"
    done

    [ -n "$found" ] && echo "${c_no}conflict${c_r}   another tunnel is capturing traffic: $found"
    return 0
}

# A vless:// link is full of & and #. Unquoted at a shell prompt, bash runs
# everything after the first & as a separate background job and hands us only
# the head of the link -- which still parses, as a plain-TCP server with no
# TLS, and then silently cannot connect. Catch it here, BEFORE sudo: a
# backgrounded job that reaches a password prompt is stopped by SIGTTIN, and
# the user never sees a word of what went wrong.
check_quoted() {
    case "$1" in
        *'#'*)     return 0 ;;   # fragment survived -> nothing was cut
        *'?'*'&'*) return 0 ;;   # & survived        -> it was quoted
        *'?'*=*)
            echo "${c_no}that link looks truncated by the shell.${c_r}" >&2
            echo "wrap it in single quotes:" >&2
            echo "  xray-tun ${c_b}add NAME 'vless://...'${c_r}" >&2
            echo "${c_dim}(unquoted, bash cuts the link at the first '&' and runs" >&2
            echo " the rest as background jobs; what is left still parses, as a" >&2
            echo " plain-TCP server that cannot connect)${c_r}" >&2
            return 1 ;;
    esac
    return 0
}

case "${1:-status}" in
    on|up|start)     cmd_on ;;
    off|down|stop)   cmd_off ;;
    toggle)          if is_on; then cmd_off; else cmd_on; fi ;;
    restart)         $SUDO systemctl restart "$UNIT" && sleep 1 && cmd_status ;;
    status|"")       cmd_status ;;
    enable)          $SUDO systemctl enable "$UNIT" && echo "will start at boot" ;;
    disable)         $SUDO systemctl disable "$UNIT" && echo "will not start at boot" ;;
    logs)            shift; $SUDO journalctl -u "$UNIT" -n 100 "${@:--f}" ;;
    add)
        shift
        # xray-tun add <name> <link>   |   xray-tun add <link>
        case $# in
          2) check_quoted "$2" || exit 2; $SUDO "$V2X" --install --name "$1" "$2" ;;
          1) check_quoted "$1" || exit 2; $SUDO "$V2X" --install "$1" ;;
          *) echo "usage: xray-tun add [name] 'vless://...'" >&2; exit 2 ;;
        esac ;;
    import)
        shift
        [ $# -ge 1 ] || { echo "usage: xray-tun import 'vless://...'" >&2; exit 2; }
        check_quoted "$1" || exit 2
        $SUDO "$V2X" --install "$@" ;;
    ls|list)         $SUDO "$V2X" --list ;;
    use|switch)
        shift
        [ $# -ge 1 ] || { echo "usage: xray-tun use <name>" >&2; exit 2; }
        $SUDO "$V2X" --use "$1" ;;
    rm|remove|del)
        shift
        [ $# -ge 1 ] || { echo "usage: xray-tun rm <name> [--force]" >&2; exit 2; }
        $SUDO "$V2X" --remove "$@" ;;
    show)
        shift
        $SUDO "$V2X" --show "$@" ;;
    check)           $SUDO /usr/bin/xray run -dump -confdir "$CONF_DIR" >/dev/null \
                         && echo "${c_ok}config OK${c_r}" \
                         || { echo "${c_no}config INVALID${c_r}"; exit 1; } ;;
    edit)            $SUDO "${EDITOR:-nano}" "$CONF" && "$0" check ;;
    edit-net)        $SUDO "${EDITOR:-nano}" "$NETCONF" ;;
    ip)              exit_ip ;;
    -h|--help|help)
        cat <<'USAGE'
xray-tun -- Xray full-tunnel VPN

  xray-tun on            start the tunnel now
  xray-tun off           stop it, restore normal routing
  xray-tun toggle        flip it
  xray-tun restart       restart (after a config change)
  xray-tun status        state, device, routes, DNS, exit IP  [default]
  xray-tun ip            print the current exit IP

  xray-tun enable        start automatically at boot
  xray-tun disable       do not start at boot

servers:
  xray-tun add NAME URL  add a server from a vless:// link, and use it
  xray-tun ls            list servers  (* = active)
  xray-tun use NAME      switch to another server
  xray-tun rm NAME       delete a server  (--force if it is active)
  xray-tun show [NAME]   details of a server; --show-link prints its URL

  xray-tun check         validate the config without starting
  xray-tun edit          edit /etc/xray-tun/config.json (server settings)
  xray-tun edit-net      edit /etc/xray-tun/xray-tun.conf (routing/DNS knobs)
  xray-tun logs [args]   journalctl for the service (follows by default)
USAGE
        ;;
    *) echo "unknown command: $1 (try: xray-tun help)" >&2; exit 2 ;;
esac
