#!/usr/bin/env python3
"""vless2xray -- convert vless:// links into Xray outbounds, and manage them.

Each server is a named profile in /etc/xray-tun/servers/<name>.json, holding
only the "proxy" outbound. The active one is /etc/xray-tun/zz-server.json, a
symlink pointing at the chosen profile.

Two facts about `xray run -confdir` make this work, both verified against the
binary rather than assumed:

  * it does NOT recurse into subdirectories, so servers/ can sit inside the
    config dir without every profile being loaded at once;
  * it DOES follow symlinks, so switching profiles is one atomic relink;
  * it applies files in name order and REPLACES same-tag outbounds, so a
    drop-in sorting after config.json cleanly overrides the placeholder there
    with no stale transport settings surviving the swap. Hence "zz-".

  vless2xray 'vless://...'                       # print the drop-in, touch nothing
  vless2xray --outbound 'vless://...'            # print just the outbound object
  pbpaste | vless2xray -                         # read the link from stdin

  sudo vless2xray --install --name tokyo 'vless://...'   # add a profile + use it
  sudo vless2xray --list                                 # list profiles
  sudo vless2xray --use tokyo                            # switch
  sudo vless2xray --remove tokyo                         # delete
  sudo vless2xray --show tokyo                           # details
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse as up

# XRAY_TUN_CONFDIR points the whole tool at another config tree -- for tests,
# or for managing an install that is not the system one. Pointing it elsewhere
# also drops the root requirement and the service restart, since neither
# applies to a tree you already own.
DEFAULT_CONF_DIR = "/etc/xray-tun"
CONF_DIR = os.environ.get("XRAY_TUN_CONFDIR") or DEFAULT_CONF_DIR
SYSTEM = os.path.abspath(CONF_DIR) == DEFAULT_CONF_DIR
SERVERS_DIRNAME = "servers"
SERVERS_DIR = os.path.join(CONF_DIR, SERVERS_DIRNAME)
DROPIN = "zz-server.json"
DROPIN_PATH = os.path.join(CONF_DIR, DROPIN)
# Older versions wrote this; it sorts BEFORE config.json and so demoted the
# proxy outbound. Removed on sight.
LEGACY_DROPINS = ("50-server.json",)
NETCONF = os.path.join(CONF_DIR, "xray-tun.conf")
SERVICE = "xray-tun.service"

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

TTY = None  # set in main(); the controlling terminal, if we have one


def die(msg):
    sys.exit(f"vless2xray: {msg}")


def warn(msg):
    print(f"vless2xray: warning: {msg}", file=sys.stderr)


def slugify(text, fallback="server"):
    """Turn a link's #remark into a usable profile name."""
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", text.strip()).strip("-.")
    slug = re.sub(r"-{2,}", "-", slug)[:64]
    return slug if slug and NAME_RE.match(slug) else fallback


def looks_truncated(link):
    """Detect a link the shell ate because it was not quoted.

    A vless:// link is full of `&` and `#`. Unquoted at a shell prompt, bash
    treats every `&` as "run the preceding command in the background", so the
    tool receives only the text up to the FIRST `&` -- and everything after it
    runs as a separate job. The cruel part is that the truncated remainder is
    still a valid link: `vless://uuid@host:443?path=/ws` parses cleanly as a
    plain-TCP server with no TLS and no WebSocket. It installs, it looks
    healthy in `ls`, and it simply cannot connect.

    Signature: a query string with a single parameter and no `#fragment` --
    because the fragment sits at the very end, so anything that survived a cut
    at the first `&` cannot still have one.
    """
    if "#" in link:
        return None                       # fragment intact: nothing was cut
    query = link.split("?", 1)[1] if "?" in link else ""
    if not query or "&" in query or "=" not in query:
        return None                       # no query, or the & survived
    return (f"only one parameter ({query.split('=')[0]}=) and no #name -- the "
            "shell probably cut it at the first '&'")


def warn_weak_security(q, port):
    """A TLS port with no security= is the other shape a mangled link takes."""
    if (q.get("security") or "none").lower() == "none" and port in (443, 8443):
        warn(f"no security= in a link to port {port}: this will connect in "
             "plaintext, if it connects at all. Is the link complete?")


def check_name(name):
    if not NAME_RE.match(name):
        die(f"bad profile name {name!r}: use letters, digits, dot, dash, "
            "underscore; must start alphanumeric, 64 chars max")
    return name


def need_root(what):
    if SYSTEM and os.geteuid() != 0:
        die(f"{what} needs root (try: sudo vless2xray ...)")


def require_confdir():
    if not os.path.isdir(CONF_DIR):
        die(f"{CONF_DIR} does not exist -- run install.sh first")


def profile_path(name):
    return os.path.join(SERVERS_DIR, name + ".json")


def strip_comments(text):
    """Drop our full-line // headers so the body can be JSON-parsed."""
    return "\n".join(l for l in text.splitlines()
                      if not l.lstrip().startswith("//"))


def read_meta(path):
    """Header metadata + a few facts dug out of the JSON body."""
    meta = {"name": "", "remark": "", "link": "", "server": "?",
            "transport": "?", "security": "?", "tag": "proxy"}
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError as e:
        meta["server"] = f"unreadable ({e.strerror})"
        return meta
    for line in text.splitlines():
        m = re.match(r"^//\s*(name|remark|link):\s*(.*)$", line.strip())
        if m:
            meta[m.group(1)] = m.group(2).strip()
    try:
        body = json.loads(strip_comments(text))
        ob = body["outbounds"][0]
        meta["tag"] = ob.get("tag", "proxy")
        v = ob["settings"]["vnext"][0]
        meta["server"] = f"{v['address']}:{v['port']}"
        st = ob.get("streamSettings", {})
        meta["transport"] = st.get("network", "?")
        meta["security"] = st.get("security", "none")
    except (OSError, ValueError, KeyError, IndexError):
        pass
    return meta


def active_name():
    """Name of the active profile, or None."""
    if not os.path.islink(DROPIN_PATH):
        return None
    target = os.readlink(DROPIN_PATH)
    base = os.path.basename(target)
    return base[:-5] if base.endswith(".json") else None


def list_profiles():
    try:
        names = [f[:-5] for f in os.listdir(SERVERS_DIR) if f.endswith(".json")]
    except OSError:
        return []
    return sorted(names)


def repair_store():
    """Fix up anything an older version, or a manual edit, left behind.

    Cheap and idempotent, so every entry point calls it first:

      * delete a stale 50-server.json -- it sorts BEFORE config.json and so
        demotes the proxy outbound (the bug the zz- prefix exists to avoid);
      * adopt a regular-file zz-server.json from the pre-profiles layout;
      * drop a dangling active symlink. xray refuses to start on one -- it
        aborts reading the whole confdir -- so healing it is what keeps
        `xray-tun on` working after someone deletes a profile by hand.
    """
    for stale in LEGACY_DROPINS:
        sp = os.path.join(CONF_DIR, stale)
        if os.path.exists(sp):
            os.remove(sp)
            print(f"removed stale {sp} (it sorted before config.json)")

    if os.path.islink(DROPIN_PATH):
        if not os.path.exists(DROPIN_PATH):        # follows the link
            gone = active_name()
            os.remove(DROPIN_PATH)
            warn(f"active profile {gone!r} was missing its file; cleared it "
                 "(xray cannot start on a dangling link)")
        return

    if not os.path.isfile(DROPIN_PATH):
        return

    os.makedirs(SERVERS_DIR, mode=0o700, exist_ok=True)
    meta = read_meta(DROPIN_PATH)
    name = check_name(slugify(meta.get("name") or meta.get("remark")
                              or "default", "default"))
    while os.path.exists(profile_path(name)):
        name += "-1"
    shutil.move(DROPIN_PATH, profile_path(name))
    os.chmod(profile_path(name), 0o600)
    link_profile(name)
    print(f"adopted the existing server as profile {name!r}")


def link_profile(name):
    """Point the drop-in at a profile, atomically."""
    tmp = DROPIN_PATH + ".tmp"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(os.path.join(SERVERS_DIRNAME, name + ".json"), tmp)
    os.replace(tmp, DROPIN_PATH)


def restart_if_running(quiet=False):
    if not SYSTEM:
        return False
    if subprocess.run(["systemctl", "is-active", "--quiet", SERVICE]).returncode == 0:
        subprocess.run(["systemctl", "restart", SERVICE], check=False)
        if not quiet:
            print(f"restarted {SERVICE}")
        return True
    if not quiet:
        print("xray-tun is not running; start it with 'xray-tun on'")
    return False


def default_mark():
    """Keep the fwmark in step with xray-tun.conf, since the two must agree."""
    try:
        with open(NETCONF) as fh:
            m = re.search(r"^\s*FWMARK=(\d+)", fh.read(), re.M)
            if m:
                return int(m.group(1))
    except OSError:
        pass
    return 255


def parse_link(link):
    link = link.strip()
    if not link:
        die("empty input")
    if link.startswith(("vmess://", "trojan://", "ss://", "hysteria2://", "tuic://")):
        die(f"{link.split('://')[0]}:// links are not supported, only vless://")
    if not link.startswith("vless://"):
        die("not a vless:// link")

    u = up.urlsplit(link)

    uuid = up.unquote(u.username or "")
    if not uuid:
        die("no UUID in the link (expected vless://UUID@host:port?...)")

    host = u.hostname
    if not host:
        die("no server address in the link")
    try:
        port = u.port
    except ValueError:
        die("invalid port")
    if not port:
        die("no server port in the link")

    # Query values arrive percent-encoded; take the last if repeated.
    q = {k: v[-1] for k, v in up.parse_qs(u.query, keep_blank_values=True).items()}
    remark = up.unquote(u.fragment) if u.fragment else ""
    return uuid, host, port, q, remark


def build_stream(q, address):
    net = (q.get("type") or "tcp").lower()
    sec = (q.get("security") or "none").lower()
    stream = {"network": "tcp" if net in ("tcp", "raw") else net}

    # ---- security ----
    sni = q.get("sni") or q.get("peer") or q.get("host") or ""
    fp = q.get("fp") or ""
    insecure = q.get("allowInsecure", q.get("insecure", "0")) in ("1", "true", "True")
    alpn = [a for a in (q.get("alpn", "").split(",")) if a]

    if sec in ("tls", "xtls"):
        if sec == "xtls":
            warn("xtls is obsolete in modern Xray; emitting tls "
                 "(use flow=xtls-rprx-vision with reality or tls instead)")
        stream["security"] = "tls"
        tls = {"serverName": sni or address}
        if fp:
            tls["fingerprint"] = fp
        if alpn:
            tls["alpn"] = alpn
        if insecure:
            tls["allowInsecure"] = True
            warn("allowInsecure=1 -- certificate checking is off for this server")
        stream["tlsSettings"] = tls

    elif sec == "reality":
        pbk = q.get("pbk", "")
        if not pbk:
            die("security=reality but no pbk (public key) in the link")
        stream["security"] = "reality"
        reality = {
            "serverName": sni,
            "fingerprint": fp or "chrome",
            "publicKey": pbk,
            "shortId": q.get("sid", ""),
            "spiderX": q.get("spx", "/"),
        }
        if q.get("pqv"):                      # post-quantum cert verify (Xray 25.x+)
            reality["mldsa65Verify"] = q["pqv"]
        stream["realitySettings"] = reality
        if not sni:
            warn("reality link has no sni -- the handshake will very likely fail")

    elif sec in ("none", ""):
        stream["security"] = "none"
    else:
        die(f"unknown security={sec!r}")

    # ---- transport ----
    path = up.unquote(q.get("path", "")) or "/"
    hosthdr = q.get("host", "")

    if stream["network"] == "tcp":
        if (q.get("headerType") or "none").lower() == "http":
            req = {"path": [path]}
            if hosthdr:
                req["headers"] = {"Host": hosthdr.split(",")}
            stream["tcpSettings"] = {"header": {"type": "http", "request": req}}

    elif stream["network"] == "ws":
        ws = {"path": path}
        if hosthdr:
            ws["host"] = hosthdr
        stream["wsSettings"] = ws

    elif stream["network"] == "httpupgrade":
        hu = {"path": path}
        if hosthdr:
            hu["host"] = hosthdr
        stream["httpupgradeSettings"] = hu

    elif stream["network"] in ("xhttp", "splithttp"):
        stream["network"] = "xhttp"
        xh = {"path": path, "mode": q.get("mode", "auto")}
        if hosthdr:
            xh["host"] = hosthdr
        if q.get("extra"):
            try:
                xh["extra"] = json.loads(up.unquote(q["extra"]))
            except json.JSONDecodeError:
                warn("could not parse the 'extra' parameter as JSON; dropped")
        stream["xhttpSettings"] = xh

    elif stream["network"] in ("grpc", "gun"):
        stream["network"] = "grpc"
        grpc = {"serviceName": up.unquote(q.get("serviceName", ""))}
        if q.get("mode", "gun") == "multi":
            grpc["multiMode"] = True
        if q.get("authority"):
            grpc["authority"] = q["authority"]
        stream["grpcSettings"] = grpc

    elif stream["network"] in ("h2", "http"):
        stream["network"] = "h2"
        h2 = {"path": path}
        if hosthdr:
            h2["host"] = hosthdr.split(",")
        stream["httpSettings"] = h2

    elif stream["network"] == "kcp":
        kcp = {"header": {"type": q.get("headerType", "none")}}
        if q.get("seed"):
            kcp["seed"] = up.unquote(q["seed"])
        stream["kcpSettings"] = kcp

    elif stream["network"] == "quic":
        stream["quicSettings"] = {
            "security": q.get("quicSecurity", "none"),
            "key": up.unquote(q.get("key", "")),
            "header": {"type": q.get("headerType", "none")},
        }
    else:
        die(f"unsupported transport type={stream['network']!r}")

    return stream


def build_outbound(link, tag, mark):
    uuid, host, port, q, remark = parse_link(link)

    user = {"id": uuid, "encryption": q.get("encryption", "none")}
    if q.get("flow"):
        user["flow"] = q["flow"]
    if q.get("level"):
        user["level"] = int(q["level"])

    warn_weak_security(q, port)
    stream = build_stream(q, host)
    if mark is not None:
        stream["sockopt"] = {"mark": mark}

    return {
        "tag": tag,
        "protocol": "vless",
        "settings": {"vnext": [{"address": host, "port": port,
                                "users": [user]}]},
        "streamSettings": stream,
        "mux": {"enabled": False},
    }, remark


def validate(dropin_text, tag):
    """Dry-run the real confdir with this drop-in swapped in.

    Copies only the top-level .json files -- servers/ is a directory and
    -confdir does not recurse, so profiles never get merged in by accident.
    Also checks the merged result actually puts `tag` FIRST: xray picks the
    first outbound as the default, and an ordering mistake silently sends
    unmatched traffic out direct instead of through the tunnel.
    """
    xray = shutil.which("xray")
    if not xray or not os.path.isdir(CONF_DIR):
        return None
    with tempfile.TemporaryDirectory() as td:
        for name in os.listdir(CONF_DIR):
            src = os.path.join(CONF_DIR, name)
            if name.endswith(".json") and name != DROPIN \
                    and name not in LEGACY_DROPINS and os.path.isfile(src):
                shutil.copy(src, td)
        with open(os.path.join(td, DROPIN), "w") as fh:
            fh.write(dropin_text)
        p = subprocess.run([xray, "run", "-dump", "-confdir", td],
                           capture_output=True, text=True)
        if p.returncode != 0:
            return p.stderr.strip().splitlines()[-1] if p.stderr.strip() else "invalid"
        try:
            merged = json.loads(p.stdout)
        except json.JSONDecodeError:
            return "xray produced output that is not JSON"
        tags = [o.get("tag") for o in merged.get("outbounds", [])]
        if tag not in tags:
            return f"outbound {tag!r} vanished after merge (tags: {tags})"
        if tags[0] != tag:
            return (f"outbound {tag!r} is not first after merge (order: {tags}); "
                    f"unmatched traffic would default to {tags[0]!r}")
    return None


def render(outbound, remark, link, name, tag):
    """A profile file: header metadata xray ignores, then the drop-in."""
    head = [f"// Generated by vless2xray. Overrides the {tag!r} outbound in config.json.",
            f"// name: {name}"]
    if remark:
        head.append(f"// remark: {remark}")
    if link:
        head.append(f"// link: {link}")
    head.append("// Re-add with:  sudo vless2xray --install --name "
                f"{name} '<vless://...>'")
    return "\n".join(head) + "\n" + json.dumps({"outbounds": [outbound]},
                                                indent=2) + "\n"


# ------------------------------------------------------------------- terminal
#
# Everything here talks to /dev/tty directly rather than stdin/stdout, for two
# reasons: these commands run under sudo, and stdout has to stay clean so
# `--show-link` and friends can still be piped into something.


class Tty:
    """The controlling terminal, or nothing at all."""

    def __init__(self):
        try:
            self.fh = open("/dev/tty", "r+b", buffering=0)
        except OSError:
            self.fh = None

    def __bool__(self):
        return self.fh is not None

    def write(self, text):
        if self.fh:
            self.fh.write(text.encode())

    def key(self):
        """One keypress, with escape sequences folded into names."""
        import select
        ch = self.fh.read(1)
        if not ch:
            return "eof"
        if ch != b"\x1b":
            return ch.decode("utf-8", "replace")
        # Escape: an arrow key sends more bytes immediately, a bare Esc does
        # not. A short select settles which one this is.
        if not select.select([self.fh], [], [], 0.05)[0]:
            return "esc"
        seq = self.fh.read(2)
        return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
                b"[H": "home", b"[F": "end"}.get(seq, "esc")

    def line(self, prompt):
        """A whole line, typed at our prompt -- the shell never sees it, so a
        pasted link cannot be mangled at its first '&'.

        The terminal is in canonical mode here, so it does the echoing and the
        line editing for us; doing either ourselves would double every
        keystroke.
        """
        self.write(prompt)
        out = b""
        while True:
            ch = self.fh.read(1)
            if not ch or ch in (b"\r", b"\n"):
                return out.decode("utf-8", "replace").strip()
            out += ch


def interactive():
    return TTY and sys.stdin.isatty()


class raw_mode:
    """Unbuffered, un-echoed keys for as long as we need them."""

    def __enter__(self):
        import termios, tty as ttymod
        self.fd = TTY.fh.fileno()
        self.saved = termios.tcgetattr(self.fd)
        ttymod.setraw(self.fd)
        TTY.write("\033[?25l")                      # hide cursor
        return self

    def __exit__(self, *exc):
        import termios
        TTY.write("\033[?25h")
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)


def _palette(on):
    codes = {"dim": "\033[2m", "b": "\033[1m", "r": "\033[0m",
             "cyan": "\033[36m", "green": "\033[32m", "red": "\033[31m",
             "yellow": "\033[33m"}
    return codes if on else dict.fromkeys(codes, "")


# Two palettes, because these go to two different places. C is for stdout,
# which may well be a pipe -- `xray-tun ls | grep` should not get escape
# codes. T is for the menus, which are drawn on /dev/tty by definition.
C = _palette(sys.stdout.isatty() and not os.environ.get("NO_COLOR"))
T = _palette(not os.environ.get("NO_COLOR"))


def width():
    try:
        return max(40, shutil.get_terminal_size().columns)
    except Exception:
        return 80


def pick(rows, title, hint="enter select \u00b7 q cancel", initial=0):
    """Arrow-key menu. rows: (key, columns, marked). Returns a key or None.

    Falls back to a numbered prompt when there is no terminal to draw on, so
    the same call works over a pipe or in a script.
    """
    if not rows:
        return None
    if not interactive():
        return None

    labels = []
    for key, cols, marked in rows:
        labels.append((("\u25cf " if marked else "  ") + cols, key))

    i = max(0, min(initial, len(rows) - 1))
    drawn = 0

    def draw():
        nonlocal drawn
        if drawn:
            TTY.write(f"\033[{drawn}A")             # back to the top
        out = [f"\r\033[K {T['b']}{title}{T['r']}  {T['dim']}{hint}{T['r']}\n",
               "\r\033[K\n"]
        w = width() - 4
        for n, (label, _) in enumerate(labels):
            text = label if len(label) <= w else label[:w - 1] + "\u2026"
            if n == i:
                out.append(f"\r\033[K {T['cyan']}\u25b8 {text}{T['r']}\n")
            else:
                out.append(f"\r\033[K   {text}\n")
        TTY.write("".join(out))
        drawn = len(out)

    try:
        with raw_mode():
            while True:
                draw()
                k = TTY.key()
                if k in ("up", "w", "k"):
                    i = (i - 1) % len(rows)
                elif k in ("down", "s", "j"):
                    i = (i + 1) % len(rows)
                elif k == "home":
                    i = 0
                elif k == "end":
                    i = len(rows) - 1
                elif k in ("\r", "\n", " "):
                    return rows[i][0]
                elif k in ("q", "esc", "\x03", "eof"):
                    return None
                elif k.isdigit() and k != "0" and int(k) <= len(rows):
                    return rows[int(k) - 1][0]
    except KeyboardInterrupt:
        return None
    finally:
        TTY.write("\n")


def confirm(question, default=False):
    if not interactive():
        return default
    tail = "[Y/n]" if default else "[y/N]"
    try:
        answer = TTY.line(f"{question} {T['dim']}{tail}{T['r']} ").lower()
    except KeyboardInterrupt:
        return False
    return default if not answer else answer.startswith("y")


def ask(question, default=""):
    if not interactive():
        return default
    shown = f" {T['dim']}[{default}]{T['r']}" if default else ""
    try:
        return TTY.line(f"{question}{shown}: ").strip() or default
    except KeyboardInterrupt:
        return ""


def profile_rows(active=None, pal=None):
    """The shared menu body: one aligned row per saved server."""
    pal = pal if pal is not None else C
    names = list_profiles()
    if not names:
        return []
    act = active if active is not None else active_name()
    wn = max(len(n) for n in names)
    metas = {n: read_meta(profile_path(n)) for n in names}
    ws = max(len(m["server"]) for m in metas.values())
    rows = []
    for n in names:
        m = metas[n]
        sec = m["security"] if m["security"] not in ("", "none") else "-"
        cols = (f"{n.ljust(wn)}  {pal['dim']}{m['server'].ljust(ws)}"
                f"  {m['transport']}/{sec}{pal['r']}")
        if m["remark"] and m["remark"] != n:
            cols += f"  {pal['dim']}{m['remark']}{pal['r']}"
        rows.append((n, cols, n == act))
    return rows


def choose_profile(title, initial_active=True):
    """Pick a profile by menu, or explain why we cannot."""
    rows = profile_rows(pal=T)
    if not rows:
        die("no servers saved yet -- add one with: xray-tun add")
    if not interactive():
        die("no server named, and no terminal to ask on "
            "(pass a name: xray-tun use NAME)")
    start = 0
    if initial_active:
        act = active_name()
        start = next((n for n, r in enumerate(rows) if r[0] == act), 0)
    return pick(rows, title, initial=start)


# ---------------------------------------------------------------- actions


def describe(outbound):
    """A short human summary of what we are about to save."""
    v = outbound["settings"]["vnext"][0]
    st = outbound["streamSettings"]
    sec = st.get("security", "none")
    lines = [("server", f"{v['address']}:{v['port']}"),
             ("transport", st.get("network", "?"))]
    net = st.get("network")
    detail = {"ws": "wsSettings", "httpupgrade": "httpupgradeSettings",
              "xhttp": "xhttpSettings", "h2": "httpSettings"}.get(net)
    if detail and st.get(detail, {}).get("path"):
        lines[-1] = ("transport", f"{net}   path {st[detail]['path']}")
    elif net == "grpc" and st.get("grpcSettings", {}).get("serviceName"):
        lines[-1] = ("transport", f"grpc   service {st['grpcSettings']['serviceName']}")
    if sec == "reality":
        lines.append(("security", f"reality   sni {st['realitySettings']['serverName']}"))
    elif sec == "tls":
        t = st.get("tlsSettings", {})
        extra = f"   sni {t.get('serverName', '?')}"
        if t.get("alpn"):
            extra += f", alpn {','.join(t['alpn'])}"
        if t.get("allowInsecure"):
            extra += "   (certificate checking OFF)"
        lines.append(("security", "tls" + extra))
    else:
        lines.append(("security", f"{T['yellow']}none -- plaintext{T['r']}"))
    flow = v["users"][0].get("flow")
    if flow:
        lines.append(("flow", flow))
    return lines


def cmd_add(link, name, tag, mark, restart, force=False):
    need_root("--install")
    require_confdir()
    repair_store()

    if not link:
        if not interactive():
            die("no link given (pass a vless:// URL, or - for stdin)")
        TTY.write(f"\n {T['b']}add a server{T['r']}  "
                  f"{T['dim']}paste the vless:// link, or blank to cancel{T['r']}\n\n")
        try:
            link = TTY.line(" link: ").strip()
        except KeyboardInterrupt:
            link = ""
        if not link:
            print("cancelled")
            return
        # Typed at our own prompt, so the shell never saw it -- no & mangling
        # is possible here, which is the whole reason this flow exists.
        force = True

    bad = looks_truncated(link)
    if bad and not force:
        die(f"that link looks truncated: {bad}.\n"
            "  Put it in single quotes:  xray-tun add NAME 'vless://...'\n"
            "  If it really is that short, add --force.")

    outbound, remark = build_outbound(link, tag, mark)
    suggested = slugify(remark, "server")

    if not name and interactive():
        TTY.write("\n")
        for k, v in describe(outbound):
            TTY.write(f"   {T['dim']}{k.ljust(10)}{T['r']}{v}\n")
        TTY.write("\n")
        name = ask(" name it", suggested)
        if not name:
            print("cancelled")
            return
        if not NAME_RE.match(name):
            die(f"bad profile name {name!r}: letters, digits, dot, dash, "
                "underscore; must start alphanumeric")
        if os.path.exists(profile_path(name)):
            if not confirm(f" {name!r} already exists -- replace it?", default=True):
                print("cancelled")
                return
    name = name or suggested
    check_name(name)

    text = render(outbound, remark, link.strip(), name, tag)
    problem = validate(text, tag)
    if problem:
        die(f"refusing to install, merged config is invalid: {problem}")

    os.makedirs(SERVERS_DIR, mode=0o700, exist_ok=True)
    dest = profile_path(name)
    existed = os.path.exists(dest)
    tmp = dest + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, dest)
    print(("updated" if existed else "added") + f" profile {name!r}"
          + (f"  ({remark})" if remark else ""))

    was = active_name()
    if was != name:
        link_profile(name)
        print(f"active profile is now {name!r}" + (f" (was {was!r})" if was else ""))
        restart = restart and True
    if restart:
        restart_if_running()
    return name


def cmd_list():
    require_confdir()
    repair_store()
    rows = profile_rows()
    if not rows:
        print("no servers yet -- add one with: xray-tun add")
        return
    act = active_name()
    # A filled dot reads better in a terminal; plain ASCII survives a pipe.
    dot = "\u25cf" if C["r"] else "*"
    for key, cols, marked in rows:
        print((f" {C['green']}{dot}{C['r']} " if marked else "   ") + cols)
    if act and act not in [r[0] for r in rows]:
        warn(f"active profile {act!r} has no file in {SERVERS_DIR}")
    elif not act:
        warn("no active server; config.json's placeholder is in use")


def cmd_use(name, restart):
    need_root("--use")
    require_confdir()
    repair_store()
    if not name:
        name = choose_profile("switch to which server?")
        if not name:
            print("cancelled")
            return
    check_name(name)
    if not os.path.exists(profile_path(name)):
        avail = ", ".join(list_profiles()) or "none"
        die(f"no profile {name!r} (have: {avail})")
    if active_name() == name:
        print(f"{name!r} is already active")
        return
    with open(profile_path(name)) as fh:
        text = fh.read()
    problem = validate(text, read_meta(profile_path(name))["tag"])
    if problem:
        die(f"refusing to switch, {name!r} produces an invalid config: {problem}")
    link_profile(name)
    print(f"active profile is now {name!r}")
    if restart:
        restart_if_running()


def cmd_remove(name, force, restart):
    need_root("--remove")
    require_confdir()
    repair_store()
    chosen_here = False
    if not name:
        name = choose_profile("remove which server?", initial_active=False)
        if not name:
            print("cancelled")
            return
        chosen_here = True
    check_name(name)
    path = profile_path(name)
    if not os.path.exists(path):
        avail = ", ".join(list_profiles()) or "none"
        die(f"no profile {name!r} (have: {avail})")

    others = [n for n in list_profiles() if n != name]
    is_active = active_name() == name

    if chosen_here:
        # Picked from a menu, so a typo is not the risk -- but deleting the
        # server you are currently using still deserves a beat.
        m = read_meta(path)
        question = f"delete {T['b']}{name}{T['r']} ({m['server']})?"
        if is_active:
            question = (f"{T['yellow']}{name}{T['r']} is the active server. "
                        "Delete it anyway?")
        if not confirm(question, default=not is_active):
            print("cancelled")
            return
        force = True
    elif is_active and not force:
        hint = (f"switch first: xray-tun use {others[0]}"
                if others else "it is the only profile")
        die(f"{name!r} is the active profile; {hint}. Use --force to remove anyway.")

    os.remove(path)
    print(f"removed profile {name!r}")

    if is_active:
        # Removing the active one: don't leave a dangling symlink behind,
        # xray refuses to start on one.
        if os.path.lexists(DROPIN_PATH):
            os.remove(DROPIN_PATH)
        if not others:
            print("no servers left; config.json's placeholder is in use again")
        elif chosen_here and interactive():
            nxt = choose_profile("switch to which server now?",
                                 initial_active=False)
            if nxt:
                link_profile(nxt)
                print(f"active profile is now {nxt!r}")
            else:
                print(f"no active server; pick one later: xray-tun use {others[0]}")
        else:
            print(f"no active profile now; pick one: xray-tun use {others[0]}")
        if restart:
            restart_if_running(quiet=True)


def cmd_show(name, want_link):
    require_confdir()
    repair_store()
    if not name:
        name = active_name()
        if not name:
            die("no active profile; name one, or add a profile first")
    check_name(name)
    path = profile_path(name)
    if not os.path.exists(path):
        avail = ", ".join(list_profiles()) or "none"
        die(f"no profile {name!r} (have: {avail})")
    m = read_meta(path)
    if want_link:
        if not m["link"]:
            die(f"no original link stored for {name!r}")
        print(m["link"])
        return
    print(f"name      {name}" + ("  (active)" if active_name() == name else ""))
    if m["remark"]:
        print(f"remark    {m['remark']}")
    print(f"server    {m['server']}")
    print(f"transport {m['transport']}")
    print(f"security  {m['security']}")
    print(f"outbound  {m['tag']}")
    print(f"file      {path}")
    if m["link"]:
        print("link      (stored; print it with --show-link)")


def mark_for(args):
    if args.no_mark:
        return None
    return args.mark if args.mark is not None else default_mark()


def main():
    ap = argparse.ArgumentParser(
        prog="vless2xray",
        description="Convert vless:// links into Xray outbounds and manage "
                    "them as named profiles for the xray-tun daemon.")
    ap.add_argument("link", nargs="?", default=None,
                    help="the vless:// URL, or - to read it from stdin")

    store = ap.add_argument_group("profile management (all need root)")
    store.add_argument("--install", action="store_true",
                       help="add the link as a profile and make it active")
    store.add_argument("--name", metavar="NAME",
                       help="profile name (default: slug of the link's #remark)")
    store.add_argument("--list", action="store_true", help="list profiles")
    store.add_argument("--use", metavar="NAME", nargs="?", const="",
                       help="switch to a profile (no name: pick from a menu)")
    store.add_argument("--remove", metavar="NAME", nargs="?", const="",
                       help="delete a profile (no name: pick from a menu)")
    store.add_argument("--force", action="store_true",
                       help="with --remove, allow removing the active profile; "
                            "with --install, accept a link that looks truncated")
    store.add_argument("--show", metavar="NAME", nargs="?", const="",
                       help="show a profile's details (default: the active one)")
    store.add_argument("--show-link", action="store_true",
                       help="with --show, print the stored vless:// link instead")
    store.add_argument("--no-restart", action="store_true",
                       help="do not restart the service after a change")

    conv = ap.add_argument_group("conversion")
    conv.add_argument("--tag", default="proxy",
                      help="outbound tag to override (default: proxy)")
    conv.add_argument("--mark", type=int, default=None,
                      help=f"sockopt fwmark (default: from {NETCONF}, else 255)")
    conv.add_argument("--no-mark", action="store_true",
                      help="omit sockopt.mark (only if you are not using the TUN)")
    conv.add_argument("--outbound", action="store_true",
                      help="print just the outbound object, not the whole file")
    conv.add_argument("-o", "--output", metavar="FILE",
                      help="write to FILE instead of stdout")
    args = ap.parse_args()

    restart = not args.no_restart

    # --- store actions, one at a time ---
    picked = [n for n, v in (("--list", args.list),
                             ("--use", args.use is not None),
                             ("--remove", args.remove is not None),
                             ("--show", args.show is not None)) if v]
    if len(picked) > 1:
        die(f"pick one of {', '.join(picked)}, not several")
    if picked and args.install:
        die(f"--install cannot be combined with {picked[0]}")

    if args.list:
        return cmd_list()
    if args.use is not None:
        return cmd_use(args.use, restart)
    if args.remove is not None:
        return cmd_remove(args.remove, args.force, restart)
    if args.show is not None:
        return cmd_show(args.show or None, args.show_link)

    # --- conversion (and optionally adding a profile) ---
    if args.link is None:
        if args.install:
            # Interactive add: cmd_add prompts for the link itself.
            return cmd_add("", args.name, args.tag, mark_for(args), restart,
                           args.force)
        if sys.stdin.isatty():
            ap.error("no link given (pass a vless:// URL, - for stdin, "
                     "or a profile action such as --list)")
        args.link = "-"
    raw = sys.stdin.read() if args.link == "-" else args.link
    links = [l for l in (x.strip() for x in raw.splitlines()) if l]
    if not links:
        die("no link given")
    if len(links) > 1:
        die(f"got {len(links)} links; pass one at a time")
    link = links[0]

    mark = mark_for(args)

    if args.install:
        return cmd_add(link, args.name, args.tag, mark, restart, args.force)

    bad = looks_truncated(link)
    if bad:
        warn(f"this link looks truncated: {bad}. Quote it: '<vless://...>'")
    outbound, remark = build_outbound(link, args.tag, mark)
    if args.outbound:
        text = json.dumps(outbound, indent=2) + "\n"
    else:
        text = render(outbound, remark, link,
                      args.name or slugify(remark, "server"), args.tag)

    if args.output:
        with open(args.output, "w") as fh:
            fh.write(text)
        print(f"wrote {args.output}", file=sys.stderr)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    TTY = Tty()
    try:
        main()
    except KeyboardInterrupt:
        if TTY:
            TTY.write("\033[?25h\n")
        sys.exit(130)
